# API runtime
PORT=8787
YTSC_API_HOST=0.0.0.0
YTSC_CONFIG_FILE=/data/config.json
YTSC_OUTPUT_DIR=/data/output

# Optional global legacy highlight-finder fallback
# YTSC_API_KEY=sk-...
# YTSC_BASE_URL=https://api.openai.com/v1
# YTSC_MODEL=gpt-4.1

# Recommended per-provider overrides
YTSC_HIGHLIGHT_FINDER_API_KEY=sk-...
# YTSC_HIGHLIGHT_FINDER_BASE_URL=https://api.openai.com/v1
# YTSC_HIGHLIGHT_FINDER_MODEL=gpt-4.1
# YTSC_HIGHLIGHT_FINDER_SYSTEM_MESSAGE=Custom system prompt

YTSC_CAPTION_MAKER_API_KEY=sk-...
# YTSC_CAPTION_MAKER_BASE_URL=https://api.openai.com/v1
# YTSC_CAPTION_MAKER_MODEL=whisper-1

YTSC_HOOK_MAKER_API_KEY=sk-...
# YTSC_HOOK_MAKER_BASE_URL=https://api.openai.com/v1
# YTSC_HOOK_MAKER_MODEL=tts-1

# Optional title generator override
# YTSC_YOUTUBE_TITLE_MAKER_API_KEY=sk-...
